{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "workflow-profile.schema.json",
  "title": "Workflow project profile",
  "description": "A project's facts for the workflow commands: commands, gates, tiers, test DBs, limits. Path: <project>/.claude/workflow-profile.json. Uses only the draft-07 keywords type, properties, required, additionalProperties, items, enum, minimum, minLength, minItems, maxItems and pattern, so a dependency-free checker can validate it. Protocol: ~/.claude/commands/_shared-project-profile.md.",
  "type": "object",
  "required": ["version", "project", "updated"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "enum": [1], "description": "Profile schema version." },
    "project": { "type": "string", "minLength": 1 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "notes": { "type": "string" },
    "docs": {
      "type": "object",
      "description": "Where the project's own rules live, as path#anchor. Skills reference these by section and never copy them.",
      "additionalProperties": { "type": "string" },
      "properties": {
        "invariants": { "type": "string" },
        "guardrails": { "type": "string" },
        "process": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "shell_prefix": { "type": "string", "description": "Prepended to every command and gate a skill runs." },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": { "type": "string" },
        "build": { "type": "string" },
        "test_task": { "type": "string", "description": "One targeted run per task. Placeholder {files}." },
        "test_lane_end": { "type": "string", "description": "Once at lane end. Placeholder {base}." },
        "test_full": { "type": "string", "description": "The one full run per cut." },
        "typecheck": { "type": "string" },
        "typecheck_clean": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "gates": {
      "type": "object",
      "description": "The gate registry: gate name -> how to run it. Tiers name gates from here.",
      "additionalProperties": {
        "type": "object",
        "required": ["cmd", "kind"],
        "additionalProperties": false,
        "properties": {
          "cmd": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["check", "test", "rehearsal", "health"] },
          "heavy": { "type": "string", "description": "A heavy_jobs slot name." },
          "smoke": { "type": "boolean", "description": "Safe to run in the scaffold's smoke run." },
          "notes": { "type": "string" }
        }
      }
    },
    "tiers": {
      "type": "object",
      "description": "When each gate runs. Every entry names a gate in the registry.",
      "additionalProperties": false,
      "properties": {
        "per_commit": { "type": "array", "items": { "type": "string" } },
        "lane_end": { "type": "array", "items": { "type": "string" } },
        "merge": { "type": "array", "items": { "type": "string" } },
        "cut_end": { "type": "array", "items": { "type": "string" } },
        "track_merge": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "invariant_suites": {
      "type": "array",
      "description": "Test paths that are never quarantined and run first at cut end.",
      "items": { "type": "string" }
    },
    "risk_routing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["paths", "verifier"],
        "additionalProperties": false,
        "properties": {
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "verifier": { "type": "string", "description": "An installed agent type." },
          "reason": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "heavy_jobs": {
      "type": "object",
      "description": "Slot name -> how many may run at once, and where the locks live.",
      "additionalProperties": {
        "type": "object",
        "required": ["slots", "lock_dir"],
        "additionalProperties": false,
        "properties": {
          "slots": { "type": "integer", "minimum": 1 },
          "lock_dir": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "test_db": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1 },
        "container": { "type": "string" },
        "name_pattern": { "type": "string", "description": "Placeholders {set}, {lane}." },
        "create": { "type": "string", "description": "Placeholder {name}." },
        "bootstrap": { "type": "string", "description": "Placeholder {url}." },
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "Template of the {url} placeholder. Placeholders {host}, {port}, {name}; {host} and {name} are required. Default postgresql://{host}:{port}/{name}. A user and password may be written in it only for a local test database."
        },
        "allow_hosts": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "range": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 1 } },
        "registry": { "type": "string" },
        "names": {
          "type": "array",
          "description": "Port names a lane gets when its lane-map entry has no \"ports\". Default [\"api\"].",
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }
        },
        "step": { "type": "integer", "minimum": 1, "description": "Distance between two lanes' base ports. Default 1." },
        "offsets": {
          "type": "object",
          "description": "Port name -> offset from the lane's base port, e.g. {\"web\": 2000}. A name without one takes the next free offset 0, 1, 2…",
          "properties": { "notes": { "type": "string" } },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "notes": { "type": "string" }
      }
    },
    "known_reds": { "type": "string", "description": "File listing reds that predate the cut." },
    "logs_dir": { "type": "string" },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_concurrent": { "type": "integer", "minimum": 1 },
        "verifier_model": { "type": "string" },
        "overrides": {
          "type": "object",
          "description": "Role -> model, where a cheaper model is allowed.",
          "additionalProperties": { "type": "string" }
        },
        "notes": { "type": "string" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "context_budget_tokens": { "type": "integer", "minimum": 1 },
        "handback_lines": { "type": "integer", "minimum": 1 },
        "stall_minutes": { "type": "integer", "minimum": 1 },
        "notes": { "type": "string" }
      }
    },
    "provenance": {
      "type": "array",
      "description": "One row per change, newest last.",
      "items": {
        "type": "object",
        "required": ["path", "source", "date", "change"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "source": { "type": "string" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "change": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
